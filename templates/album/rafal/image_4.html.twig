<div class="frame-thumb frame-thumb-left col-6 text-right">
    <a href="{{ getRoute(item.slug) }}">
        <img src="{{ images[0].filePath.thumbPublicPath }}" class="img-fluid"
             width="{{ images[0].imageDetails.thumbWidth }}"
             height="{{ images[0].imageDetails.thumbHeight }}"
             alt="{{ item.title }}">
    </a>
</div>

