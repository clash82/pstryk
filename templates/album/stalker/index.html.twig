{% extends 'album/stalker/base.html.twig' %}

{% block title %}Rafał Toborek{% endblock %}
{% block description %}Inspiracją do stworzenia tego albumu była książka braci Strugackich pt. <a href="https://pl.wikipedia.org/wiki/Piknik_na_skraju_drogi" target="_blank">Piknik na skraju drogi</a>. To właśnie do tej książki odsyłam cię jeśli chcesz dowiedzieć się kim są stalkerzy i czym się zajmują.{% endblock %}
{% block image %}{% if items[0] is defined and items[0].getMainImage(show_hidden|default(false)) is not empty %}{{ getRoute(null) }}/{{ items[0].getMainImage(show_hidden|default(false)).filePath.thumbPublicPath }}{% endif %}{% endblock %}

{% block body %}
    {% if items is defined %}
        {% for item in items %}
            <div class="row frame">
                <div class="frame-title col-12 col-sm-7 text-center text-sm-left">
                    {{ item.title }}{{ include('album/parts/hidden_badge.html.twig') }}
                </div>
                <div class="frame-date col-12 col-sm-5 text-center text-sm-right"
                     data-date="{{ item.date|date('r') }}" title="{{ item.date|date('Y-m-d') }}">
                    {{ item.date|date('Y-m-d') }}
                </div>

                <div class="frame-thumb col-12 text-center">
                    <a href="{{ getRoute(item.slug) }}">
                        {% if item.getMainImage(show_hidden|default(false)) is not empty %}
                            <img src="{{ item.getMainImage(show_hidden|default(false)).filePath.thumbPublicPath }}" class="img-fluid"
                                 width="{{ item.getMainImage(show_hidden|default(false)).imageDetails.thumbWidth }}"
                                 height="{{ item.getMainImage(show_hidden|default(false)).imageDetails.thumbHeight }}"
                                 alt="{{ item.title }}">
                        {% endif %}
                    </a>
                </div>

                <div class="frame-description col-12 text-center">
                    {{ item.description|nl2br }}
                </div>
            </div>
        {% endfor %}
    {% endif %}

    <div class="paginator">
        <div class="col-12">
            {{ knp_pagination_render(items, template = 'album/parts/pagination.html.twig', viewParams = {'align': 'center'}) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ include('album/rafal/item_js.html.twig') }}
{% endblock %}
