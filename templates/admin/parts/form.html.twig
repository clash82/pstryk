{% extends 'admin/base.html.twig' %}

{% block body %}
    <script>
        $(document).ready(function() {
            $('.form-datetimepicker').flatpickr({
                enableTime: true,
                dateFormat: 'Y-m-d H:i',
                altInput: true,
                altFormat: 'j F Y / H:i'
            });

            $('.btn-return').click(function() {
                location.href = '{{ app.request.query.get('return')|e('js') }}';
            });

            function onInit() {
                $('.image-preview').magnificPopup({
                    'type': 'image',
                    'closeOnContentClick': true,
                    'closeOnBgClick': true,
                    'showCloseBtn': true,
                    'gallery': {
                        'enabled': true,
                        'tPrev': 'Poprzedni (w lewo)',
                        'tNext': 'Następny (w prawo)',
                        'tCounter': '<span class="mfp-counter">obraz %curr% z %total%</span>'
                    }
                });

                // the cover image must always be public, so its "Publiczny" checkbox is forced and locked
                function syncPublicCheckboxes() {
                    $('.form-images-container').each(function () {
                        var isMain = $(this).find('input[type=radio]').prop('checked');
                        var $public = $(this).find('input[type=checkbox]');

                        if (isMain) {
                            $public.prop('checked', true).prop('disabled', true);
                        } else {
                            $public.prop('disabled', false);
                        }
                    });
                }

                $('input[type=radio]').off('change.public').on('change.public', function () {
                    $('input[type=radio]').not($(this)).prop('checked', false);
                    syncPublicCheckboxes();
                });

                $('input[type=file]').change(function() {
                    var filename = $(this).val();
                    var fieldId = $(this).attr('id').match(/\d+/)[0];
                    var lastIndex = filename.lastIndexOf("\\");
                    var reader = new FileReader();

                    // updating filename field
                    if (lastIndex >= 0) {
                        filename = filename.substring(lastIndex + 1);
                    }
                    $('#item_images_' + fieldId + '_name').val(filename);

                    // updating image preview
                    reader.onload = function(e) {
                        $('#item_image_'+ fieldId +'_thumb').attr('src', e.target.result);
                        $('#item_image_'+ fieldId +'_thumb').parent().attr('href', e.target.result);
                    };
                    reader.readAsDataURL($(this).prop('files')[0]);
                });

                if ($('input[type=radio]:checked').length === 0) {
                    $('input[type=radio]').first().prop('checked', true);
                }

                syncPublicCheckboxes();
            }

            $('.images-collection').collection({
                'allow_duplicates': false,
                'position_field_selector': '.image-position',
                'add': '<a href="#" class="btn btn-default"><span class="fas fa-plus"></span></a>',
                'after_init': function () {
                    onInit();
                },
                'after_add': function (collection, element) {
                    // the collection prototype is rendered without entity data, so the new row's
                    // "Publiczny" checkbox has to be checked by hand to match the entity default
                    $(element).find('input[type=checkbox]').prop('checked', true);

                    onInit();

                    return true;
                }
            });

            // drop zone placed right above the list of attached images; every dropped file gets its own row
            (function () {
                var $collection = $('.images-collection');
                // the limit comes from the file constraint defined in ImageType (rendered into the prototype)
                var $prototypeInput = $('<div>').html($collection.data('prototype') || '').find('input[type=file]').first();
                var maxSize = parseInt($prototypeInput.attr('data-max-size'), 10) || 0;
                var maxSizeMessage = $prototypeInput.attr('data-max-size-message') || 'Plik jest za duży';
                // Symfony's "5M" means 5 000 000 bytes, so sizes are shown in decimal megabytes as well
                var maxSizeLabel = (maxSize / 1000000).toFixed(maxSize % 1000000 ? 1 : 0) + ' MB';
                var added = {};

                if ($collection.length === 0 || typeof DataTransfer === 'undefined') {
                    return;
                }

                var $zone = $(
                    '<div class="dropzone">' +
                        '<span class="fas fa-cloud-upload-alt dropzone-icon"></span>' +
                        '<div class="dropzone-hint"></div>' +
                        '<div class="dropzone-status"></div>' +
                        '<div class="dropzone-messages"></div>' +
                    '</div>'
                ).insertBefore($collection);
                var $messages = $zone.find('.dropzone-messages');

                $zone.find('.dropzone-hint').text(
                    'Przeciągnij tutaj zdjęcia (JPEG' + (maxSize ? ', maks. ' + maxSizeLabel : '') + ')'
                );

                function isEmptyRow($row) {
                    return $.trim($row.find('input[id$="_name"]').val() || '') === '';
                }

                function nextRow() {
                    var $rows = $collection.find('.form-images-container');
                    var $last = $rows.last();

                    // reuse a trailing row that has no image yet
                    if ($last.length && isEmptyRow($last)) {
                        return $last;
                    }

                    // otherwise append a new row after the last one (or via the main "add" button for an empty list)
                    if ($last.length) {
                        $last.find('.collection-add').first().trigger('click');
                    } else {
                        // with no rows left the plugin only renders its "rescue" add button; its class is
                        // prefixed with the generated collection id, so it can only be matched by suffix
                        $collection.find('[class*="collection-rescue-add"]').first().trigger('click');
                    }

                    return $collection.find('.form-images-container').last();
                }

                // Every dropped file is sent in its own request (up to "maxParallel" at a time), so the number
                // of files is not limited by max_file_uploads, post_max_size or max_input_time. The server also
                // generates the resized image and the thumbnail right away (they depend on the chosen album),
                // so saving the form is quick and only has to move the ready files. The form gets just a token
                // of the stored file, which is why it cannot be submitted before the queue is empty.
                var uploadUrl = '{{ path('app_admin_item_upload_image')|e('js') }}';
                var processUrl = '{{ path('app_admin_item_process_image')|e('js') }}';
                var maxParallel = 3;
                var maxAttempts = 4;
                var queue = [];
                var active = 0;
                var pending = 0;
                var finished = 0;
                var total = 0;
                var submitAfterUploads = false;
                var $form = $collection.closest('form');
                var $status = $zone.find('.dropzone-status');
                var $album = $('#item_album');

                function currentAlbum() {
                    return $album.val() || '';
                }

                function showError(message) {
                    $('<div class="dropzone-error"></div>').text(message).appendTo($messages);
                }

                function updateStatus() {
                    if (pending === 0) {
                        $status.text(total > 0 ? 'Przesłano i przetworzono wszystkie pliki (' + finished + ')' : '');
                        $zone.removeClass('uploading');
                        total = finished = 0;

                        return;
                    }

                    $zone.addClass('uploading');
                    $status.text('Przesyłanie i przetwarzanie plików: ' + finished + ' z ' + total + '…');
                }

                function setRowStatus(task, text, failed) {
                    task.$status.text(text).toggleClass('upload-failed', !!failed);
                }

                function enqueue(task) {
                    queue.push(task);
                    pending++;
                    total++;
                    updateStatus();
                    pump();
                }

                function finishTask(task, ok) {
                    active--;
                    pending--;
                    finished++;
                    task.$row.data('busy', false);

                    if (!ok && task.type === 'upload') {
                        // the entry cannot be saved without its file, so it is taken off the list
                        delete added[task.key];
                        task.$row.find('.collection-remove').first().trigger('click');
                    }

                    if (ok) {
                        task.$row.data('album', task.album);

                        // another album has been chosen while this file was being handled
                        syncAlbum(task.$row);
                    }

                    updateStatus();
                    pump();

                    if (pending === 0 && submitAfterUploads) {
                        submitAfterUploads = false;
                        $form.find(':submit').first().trigger('click');
                    }
                }

                // converts an already uploaded file again when its album is not the one chosen in the form
                function syncAlbum($row) {
                    var album = currentAlbum();
                    var $token = $row.find('input[id$="_uploadToken"]');

                    if (!album || !$token.val() || $row.data('busy') || $row.data('album') === album) {
                        return;
                    }

                    $row.data('busy', true);
                    enqueue({
                        type: 'process', file: {name: $row.find('input[id$="_name"]').val()}, $row: $row,
                        $token: $token, $status: $row.find('.upload-status'), album: album, attempt: 0
                    });
                }

                function send(task) {
                    var xhr = new XMLHttpRequest();
                    var data = new FormData();

                    task.attempt++;
                    task.album = currentAlbum();
                    data.append('album', task.album);

                    if (task.type === 'upload') {
                        data.append('file', task.file, task.file.name);
                    } else {
                        data.append('token', task.$token.val());
                    }

                    xhr.open('POST', task.type === 'upload' ? uploadUrl : processUrl);
                    xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');

                    xhr.upload.onprogress = function (e) {
                        if (e.lengthComputable) {
                            setRowStatus(task, 'Przesyłanie… ' + Math.round(e.loaded / e.total * 100) + '%');
                        }
                    };

                    // the whole file has been sent, now the server converts it
                    xhr.upload.onload = function () {
                        setRowStatus(task, 'Przetwarzanie…');
                    };

                    xhr.onload = function () {
                        var response = null;

                        try {
                            response = JSON.parse(xhr.responseText);
                        } catch (e) {
                            // not JSON, e.g. the login page after the session has expired
                        }

                        if (xhr.status === 200 && response && response.errorCode === 0 && (response.token || task.type === 'process')) {
                            if (task.type === 'upload') {
                                task.$token.val(response.token);
                            }

                            setRowStatus(task, 'Gotowe');
                            finishTask(task, true);

                            return;
                        }

                        // the server understood the request and rejected the file, so a retry would not help
                        if (xhr.status === 422) {
                            showError(task.file.name + ': ' + (response && response.errorDescription
                                ? response.errorDescription
                                : 'serwer odrzucił plik'));
                            finishTask(task, false);

                            return;
                        }

                        // an answer that is not the expected JSON (e.g. the login page) or a client error
                        // means a lost session or a wrong request - retrying would not change anything
                        if ((xhr.status === 200 && !response) || (xhr.status >= 400 && xhr.status < 500 && xhr.status !== 408 && xhr.status !== 429)) {
                            showError(task.file.name + ': serwer odrzucił plik (' + xhr.status + '), być może sesja wygasła - odśwież stronę');
                            finishTask(task, false);

                            return;
                        }

                        retryOrFail(task, 'błąd serwera (' + xhr.status + ')');
                    };

                    xhr.onerror = xhr.ontimeout = function () {
                        retryOrFail(task, 'przerwane połączenie');
                    };

                    xhr.send(data);
                }

                function retryOrFail(task, reason) {
                    if (task.attempt >= maxAttempts) {
                        showError(task.file.name + ': nie udało się przesłać pliku (' + reason + ')');
                        finishTask(task, false);

                        return;
                    }

                    setRowStatus(task, 'Ponawianie… (' + task.attempt + '/' + (maxAttempts - 1) + ')', true);
                    setTimeout(function () { send(task); }, task.attempt * 1500);
                }

                function pump() {
                    while (active < maxParallel && queue.length > 0) {
                        active++;
                        setRowStatus(queue[0], 'Przesyłanie…');
                        send(queue.shift());
                    }
                }

                function addFile(file, key) {
                    var $row = nextRow();
                    var $nameInput = $row.find('input[id$="_name"]');
                    var $token = $row.find('input[id$="_uploadToken"]');
                    var $fileInput = $row.find('input[type=file]');

                    if ($fileInput.length === 0 || $token.length === 0) {
                        return false;
                    }

                    var fieldId = $fileInput.attr('id').match(/\d+/)[0];
                    var previewUrl = URL.createObjectURL(file);
                    var $rowStatus = $row.find('.upload-status');

                    if ($rowStatus.length === 0) {
                        $rowStatus = $('<div class="upload-status"></div>').insertAfter($nameInput);
                    }

                    // the same things the regular file input change handler does
                    $nameInput.val(file.name);
                    $('#item_image_' + fieldId + '_thumb').attr('src', previewUrl).parent().attr('href', previewUrl);
                    $token.val('');
                    $row.data('album', null).data('busy', true);

                    enqueue({type: 'upload', file: file, key: key, $row: $row, $token: $token, $status: $rowStatus, attempt: 0});

                    return true;
                }

                function handleFiles(files) {
                    $messages.empty();

                    if (!currentAlbum()) {
                        showError('Wybierz album, zanim dodasz zdjęcia (rozmiar i znak wodny zależą od albumu)');

                        return;
                    }

                    $.each(files, function (i, file) {
                        var key = [file.name, file.size, file.lastModified].join('|');

                        if (file.type !== 'image/jpeg') {
                            showError(file.name + ': dozwolone są tylko pliki JPEG');
                        } else if (maxSize && file.size > maxSize) {
                            showError(file.name + ': ' + maxSizeMessage + ' (' + (Math.ceil(file.size / 100000) / 10).toFixed(1) + ' MB)');
                        } else if (added[key]) {
                            showError(file.name + ': plik został już dodany');
                        } else if (addFile(file, key)) {
                            added[key] = true;
                        } else {
                            showError(file.name + ': nie udało się dodać pliku do listy');
                        }
                    });
                }

                // images that are already on the server have to be converted again for the new album
                $album.on('change', function () {
                    $collection.find('.form-images-container').each(function () {
                        syncAlbum($(this));
                    });
                });

                // the form must not be sent before every dropped file has reached the server
                $form.on('submit', function (e) {
                    if (pending > 0) {
                        e.preventDefault();
                        submitAfterUploads = true;
                        $status.text('Formularz zostanie zapisany po przesłaniu wszystkich plików (' + finished + ' z ' + total + ')…');
                    }
                });

                $(window).on('beforeunload', function () {
                    if (pending > 0) {
                        return 'Trwa przesyłanie plików.';
                    }
                });

                function hasFiles(event) {
                    var types = event.originalEvent.dataTransfer && event.originalEvent.dataTransfer.types;

                    return !!types && $.inArray('Files', types) !== -1;
                }

                var depth = 0;

                $zone.on('dragenter', function (e) {
                    if (!hasFiles(e)) { return; }
                    e.preventDefault();
                    depth++;
                    $zone.addClass('dragover');
                }).on('dragover', function (e) {
                    if (!hasFiles(e)) { return; }
                    e.preventDefault();
                    e.originalEvent.dataTransfer.dropEffect = 'copy';
                }).on('dragleave', function () {
                    depth = Math.max(0, depth - 1);
                    if (depth === 0) { $zone.removeClass('dragover'); }
                }).on('drop', function (e) {
                    if (!hasFiles(e)) { return; }
                    e.preventDefault();
                    depth = 0;
                    $zone.removeClass('dragover');
                    handleFiles(e.originalEvent.dataTransfer.files);
                });

                // a file dropped beside the zone must not make the browser navigate to it
                $(window).on('dragover drop', function (e) {
                    if (hasFiles(e) && !$(e.target).closest('.dropzone').length) {
                        e.preventDefault();
                    }
                });
            })();
        });
    </script>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title text-center">{{ title }}</div>
                </div>
                <div class="card-body">
                    {% import 'admin/parts/form_layout.html.twig' as editForm %}
                    {% form_theme form with [
                        'admin/parts/form_fields.html.twig',
                        'admin/parts/jquery.collection.html.twig',
                        'admin/parts/form_image.html.twig'
                    ] %}

                    {{ editForm.display_form(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
